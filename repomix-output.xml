<file path="app/login/page.tsx">
'use client';

import { useState, useEffect, Suspense } from 'react';
import { useRouter, useSearchParams } from 'next/navigation';
import { 
  User, 
  Eye, 
  EyeOff, 
  LogIn, 
  ShieldCheck, 
  AlertCircle, 
  CheckCircle2, 
  WifiOff,
  Building2,
  PhoneCall,
  KeyRound,
  UserPlus,
  Loader2,
  Moon,
  Sun,
  Clock,
  Info,
  Activity,
  Award,
  HeartPulse
} from 'lucide-react';
import Link from 'next/link';
import { supabase } from '@/lib/supabase';
import PublicHeader from '@/components/public/PublicHeader';
import PublicFooter from '@/components/public/PublicFooter';

function LoginFormInner() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const redirectTo = searchParams?.get('redirect') || null;
  const reason = searchParams?.get('reason') || null;

  const [emailOrUsername, setEmailOrUsername] = useState('');
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [rememberMe, setRememberMe] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [loadingStepText, setLoadingStepText] = useState('Masuk ke Sistem SIMRS');
  const [errorMessage, setErrorMessage] = useState<string | null>(null);
  const [successMessage, setSuccessMessage] = useState<string | null>(null);
  const [isOffline, setIsOffline] = useState<boolean>(false);
  const [isCapsLockOn, setIsCapsLockOn] = useState<boolean>(false);
  const [shakeCard, setShakeCard] = useState<boolean>(false);
  const [isDarkMode, setIsDarkMode] = useState<boolean>(false);
  const [activeField, setActiveField] = useState<string | null>(null);
  const [currentShiftInfo, setCurrentShiftInfo] = useState<string>('Shift Reguler');
  const [noticeMessage, setNoticeMessage] = useState<string | null>(null);

  useEffect(() => {
    const handleOnline = () => setIsOffline(false);
    const handleOffline = () => setIsOffline(true);

    if (typeof window !== 'undefined') {
      setIsOffline(!navigator.onLine);
      window.addEventListener('online', handleOnline);
      window.addEventListener('offline', handleOffline);

      const savedEmail = localStorage.getItem('rsud_saved_login_id');
      if (savedEmail) {
        setEmailOrUsername(savedEmail);
        setRememberMe(true);
      }

      const savedTheme = localStorage.getItem('rsud_login_dark_mode');
      if (savedTheme === 'true') {
        setIsDarkMode(true);
      }

      if (reason === 'force_logout') {
        setNoticeMessage('Sesi Anda telah diakhiri secara paksa oleh Administrator Rumah Sakit.');
      } else if (reason === 'session_expired') {
        setNoticeMessage('Sesi login Anda telah berakhir. Silakan masuk kembali.');
      }

      const currentHour = new Date().getHours();
      if (currentHour >= 7 && currentHour < 14) {
        setCurrentShiftInfo('☀️ Shift Pagi');
      } else if (currentHour >= 14 && currentHour < 21) {
        setCurrentShiftInfo('🌇 Shift Sore');
      } else {
        setCurrentShiftInfo('🌙 Shift Malam');
      }
    }

    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
    };
  }, [reason]);

  const toggleDarkMode = () => {
    const newMode = !isDarkMode;
    setIsDarkMode(newMode);
    if (typeof window !== 'undefined') {
      localStorage.setItem('rsud_login_dark_mode', String(newMode));
    }
  };

  const triggerError = (msg: string) => {
    setErrorMessage(msg);
    setShakeCard(true);
    setTimeout(() => setShakeCard(false), 500);
  };

  // PEREKAM GAGAL LOGIN IP (BRUTE-FORCE PROTECTION)
  const recordFailedIpToDatabase = async () => {
    try {
      const res = await fetch('https://api.ipify.org?format=json');
      const data = await res.json();
      const clientIp = data.ip;

      if (clientIp) {
        await supabase.rpc('record_failed_login_ip', { target_ip: clientIp });
      }
    } catch (err) {
      console.error('Gagal mencatat IP gagal login:', err);
    }
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();

    setErrorMessage(null);
    setSuccessMessage(null);
    setNoticeMessage(null);

    const cleanInput = emailOrUsername.trim();
    const cleanPassword = password.trim();

    if (!cleanInput || !cleanPassword) {
      triggerError('Email dan Kata Sandi wajib diisi!');
      return;
    }

    setIsLoading(true);

    try {
      setLoadingStepText('Memeriksa Kredensial...');
      const inputEmail = cleanInput.toLowerCase();

      if (rememberMe) {
        localStorage.setItem('rsud_saved_login_id', cleanInput);
      } else {
        localStorage.removeItem('rsud_saved_login_id');
      }

      // 1. Cek Data User & Status Lockout di Tabel public.users (Kecuali Super Admin Utama)
      if (inputEmail !== 'mohdikbal1207@gmail.com') {
        const { data: userData, error: userCheckError } = await supabase
          .from('users')
          .select('failed_attempts, lockout_until, is_active')
          .eq('email', inputEmail)
          .maybeSingle();

        if (userData) {
          // Cek Apakah Akun Sedang Terkunci (Lockout Aktif)
          if (userData.lockout_until && new Date(userData.lockout_until) > new Date()) {
            const remainingMinutes = Math.ceil((new Date(userData.lockout_until).getTime() - new Date().getTime()) / 60000);
            await recordFailedIpToDatabase();
            throw new Error(`⚠️ Akun terkunci sementara karena terlalu banyak percobaan gagal. Silakan coba lagi dalam ${remainingMinutes} menit.`);
          }

          if (userData.is_active === false) {
            await recordFailedIpToDatabase();
            throw new Error('Akun Anda dinonaktifkan oleh Administrator.');
          }
        }
      }

      // 2. Tembak Supabase Auth Utama
      const { data: authData, error: authError } = await supabase.auth.signInWithPassword({
        email: inputEmail,
        password: cleanPassword,
      });

      if (authError) {
        await recordFailedIpToDatabase();

        if (inputEmail !== 'mohdikbal1207@gmail.com') {
          const { data: currentUserData } = await supabase
            .from('users')
            .select('failed_attempts')
            .eq('email', inputEmail)
            .maybeSingle();

          if (currentUserData) {
            const newFailedAttempts = (currentUserData.failed_attempts || 0) + 1;
            let lockoutTime = null;

            if (newFailedAttempts >= 4) {
              lockoutTime = new Date(Date.now() + 15 * 60 * 1000).toISOString();
            }

            await supabase
              .from('users')
              .update({
                failed_attempts: newFailedAttempts,
                lockout_until: lockoutTime,
              })
              .eq('email', inputEmail);

            if (newFailedAttempts >= 4) {
              throw new Error('⚠️ Terlalu banyak percobaan salah. Akun Anda diblokir sementara selama 15 menit demi keamanan.');
            } else {
              throw new Error(`Kata sandi salah! Sisa percobaan: ${4 - newFailedAttempts} kali lagi sebelum akun dikunci.`);
            }
          }
        }
        throw new Error('Email atau Kata Sandi yang Anda masukkan salah.');
      }

      if (!authData?.user) {
        throw new Error('Sesi pengguna tidak ditemukan.');
      }

      setLoadingStepText('Memverifikasi Hak Akses...');

      // 3. Cek Role & Reset Gagal Login Menjadi 0 jika Berhasil
      let userRole = 'kasir';
      let namaLengkap = inputEmail.split('@')[0];

      if (inputEmail === 'mohdikbal1207@gmail.com') {
        userRole = 'admin';
        namaLengkap = 'Mohd Ikbal (Admin)';
      } else {
        const { data: userData } = await supabase
          .from('users')
          .select('role, is_active, nama_lengkap')
          .eq('email', inputEmail)
          .maybeSingle();

        if (userData) {
          userRole = userData.role?.toLowerCase() || 'kasir';
          namaLengkap = userData.nama_lengkap || namaLengkap;
        }

        await supabase
          .from('users')
          .update({
            failed_attempts: 0,
            lockout_until: null,
          })
          .eq('email', inputEmail);
      }

      // ================= TAMBAHAN PENTING: AKTIFKAN KEMBALI SESI DI user_sessions =================
      await supabase
        .from('user_sessions')
        .upsert({
          user_id: authData.user.id,
          nama_lengkap: namaLengkap,
          role: userRole,
          login_at: new Date().toISOString(),
          is_active: true // Mengaktifkan kembali sesi agar lolos pengecekan middleware
        }, {
          onConflict: 'user_id'
        });
      // =========================================================================================

      setLoadingStepText('Mengalihkan Halaman...');
      setSuccessMessage(`Login Berhasil! Selamat datang ${namaLengkap}.`);

      // 4. Tentukan Target Pengarahan
      let targetUrl = '/kasir';
      if (redirectTo) {
        targetUrl = redirectTo;
      } else if (userRole === 'admin') {
        targetUrl = '/admin';
      } else if (userRole === 'manajemen' || userRole === 'management') {
        targetUrl = '/manajemen';
      }

      setTimeout(() => {
        window.location.assign(targetUrl);
      }, 300);

    } catch (err: unknown) {
      if (err instanceof Error) {
        triggerError(err.message);
      } else {
        triggerError('Terjadi kesalahan jaringan/sistem.');
      }
    } finally {
      setIsLoading(false);
      setLoadingStepText('Masuk ke Sistem SIMRS');
    }
  };

