                      <div 
                        className={`h-full transition-all duration-500 ${distance <= officeLocation.radius_meter ? 'bg-emerald-500' : 'bg-rose-500'}`}
                        style={{ width: `${Math.min(100, (distance / (officeLocation.radius_meter * 2)) * 100)}%` }}
                      ></div>
                    </div>
                  </div>
