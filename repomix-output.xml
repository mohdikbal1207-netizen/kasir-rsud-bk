  const totalBahanObat = records.filter(r => r.kode_akun === '5.2.2.02.01' && r.status_verifikasi === 'Disetujui').reduce((acc, curr) => acc + (curr.jumlah || 0), 0);
  const totalJasaMedis = records.filter(r => r.kode_akun === '5.2.2.03.01' && r.status_verifikasi === 'Disetujui').reduce((acc, curr) => acc + (curr.jumlah || 0), 0);

  const estimatedPlafon = 1000000000;
  const percentageUsed = Math.min(Math.round((totalApprovedNominal / estimatedPlafon) * 100), 100);

