      showToast(`Status kunci diubah menjadi ${!currentLocked ? 'Locked' : 'Unlocked'}.`, 'info');
      addLog(`Mengubah status kunci ID ${id} menjadi ${!currentLocked ? 'Locked' : 'Unlocked'}`);
