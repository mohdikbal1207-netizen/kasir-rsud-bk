  const handleBulkApprove = async () => {
    if (selectedIds.length === 0) return;
    try {
      const { error } = await supabase.from('kwitansi_header').update({ status_verifikasi: 'Disetujui' }).in('id', selectedIds);
      if (error) throw error;

