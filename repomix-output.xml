      </div>

      {/* Modal Peringatan Sesi Inaktif Manajemen */}
      {showTimeoutWarning && !isQuickLocked && (
        <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 animate-in fade-in">
