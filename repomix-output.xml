              <Tag className="w-3 h-3" /> Tag Cepat:
            </span>
            {['BPJS', 'Kasir', 'Tarif', 'Shift', 'Sistem'].map((tag) => (
              <button
                key={tag}
                onClick={() => setSearchTerm(searchTerm === tag ? '' : tag)}
                className={`text-[10px] font-bold px-2.5 py-1 rounded-xl transition cursor-pointer border ${
                  searchTerm === tag ? 'bg-purple-600 text-white border-purple-600' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-100'
                }`}
              >
                #{tag}
              </button>
            ))}
            {searchTerm && (
              <button
