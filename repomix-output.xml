                  className="px-6 py-2.5 bg-sky-600 hover:bg-sky-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white rounded-xl font-bold shadow-md cursor-pointer transition"
                >
                  Kirim Absensi Resmi
                </button>
              </div>
            </form>
          </div>
        </div>
