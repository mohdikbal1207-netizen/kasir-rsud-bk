                      <span className="block text-xs">Kamera belum aktif / terputus</span>
                      <button
                        type="button"
                        onClick={startCamera}
                        className="px-3 py-1.5 bg-sky-600 hover:bg-sky-700 text-white rounded-xl text-xs font-bold transition shadow"
