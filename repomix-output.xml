<file path="app/admin/rawat-jalan/page.tsx">
'use client';

import { useState, useEffect, useCallback, useRef } from 'react';
import { useRouter } from 'next/navigation';
import { 
  ShieldCheck, 
  Search, 
  RefreshCw, 
  CheckCircle2, 
  ArrowLeft, 
  Check, 
  Stethoscope,
  Eye,
  X,
  Printer,
  Clock,
  DollarSign,
  UserCheck,
  Users,
  FileText,
  Trash2,
  XCircle,
  AlertTriangle,
  MessageSquare,
  CheckSquare,
  Square,
  FileSpreadsheet,
  Calendar,
  CreditCard,
  Zap,
  LayoutGrid,
  List,
  BarChart3,
  Building2,
  CheckCircle,
  Info,
  ArrowUpDown,
  ShieldAlert,
  RotateCcw,
  SlidersHorizontal
} from 'lucide-react';
import { supabase } from '@/lib/supabase';
import AdminHeader from '@/components/admin/AdminHeader';
import AdminFooter from '@/components/admin/AdminFooter';

interface TransactionItem {
  id: string;
  no_rm?: string;
  nama_pasien?: string;
  nik?: string;
  alamat?: string;
  jenis_penjaminan?: string;
  no_kartu_bpjs?: string;
  no_sep?: string;
  metode_pembayaran?: string;
  poli_tujuan?: string;
  total_biaya: number;
  status_bayar: 'pending' | 'lunas' | 'dibatalkan';
  catatan_admin?: string;
  tanggal_transaksi?: string;
  petugas_input_nama?: string;
  petugas_input_nip?: string;
  ttd_petugas_url?: string;
  rincian_layanan?: any;
  jenis_layanan?: string;
}

interface PasienItem {
  no_rm: string;
  nama_pasien: string;
  nik?: string;
  alamat?: string;
  jenis_penjaminan?: string;
  no_kartu_bpjs?: string;
  created_at?: string;
}

export default function AdminRawatJalanVerification() {
  const router = useRouter();
  
  // [OPTIMASI EGRESS & LOG INGESTION]: Ref AbortController untuk membatalkan query gantung/duplikat
  const abortControllerRef = useRef<AbortController | null>(null);

  const [activeTab, setActiveTab] = useState<'pending' | 'lunas' | 'dibatalkan' | 'pasien' | 'semua'>('pending');
  const [transactions, setTransactions] = useState<TransactionItem[]>([]);
  const [patients, setPatients] = useState<PasienItem[]>([]);
  const [isLoading, setIsLoading] = useState<boolean>(true);
  const [searchTerm, setSearchTerm] = useState<string>('');
  const [selectedDetail, setSelectedDetail] = useState<TransactionItem | null>(null);

  const [viewMode, setViewMode] = useState<'grid' | 'table'>('grid');
  const [showStatsModal, setShowStatsModal] = useState<boolean>(false);
  
  const [isPrintingSummary, setIsPrintingSummary] = useState<boolean>(false);
  const [isPrintingSelected, setIsPrintingSelected] = useState<boolean>(false);

  const [toast, setToast] = useState<{ message: string; type: 'success' | 'error' | 'info' } | null>(null);

  const [filterMetode, setFilterMetode] = useState<string>('ALL');
  const [filterPenjaminan, setFilterPenjaminan] = useState<string>('ALL');
  const [filterTanggal, setFilterTanggal] = useState<string>('');
  const [sortBy, setSortBy] = useState<'newest' | 'oldest' | 'highest' | 'lowest'>('newest');

  const [selectedTxIds, setSelectedTxIds] = useState<string[]>([]);

  const [rejectingTx, setRejectingTx] = useState<TransactionItem | null>(null);
  const [adminNoteInput, setAdminNoteInput] = useState<string>('');

  const searchInputRef = useRef<HTMLInputElement | null>(null);

  const showToast = (message: string, type: 'success' | 'error' | 'info' = 'success') => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 4000);
  };

  const parseRincianLayanan = (data: any) => {
    if (!data) return {};
    if (typeof data === 'object') return data;
    try {
      return JSON.parse(data);
    } catch {
      return {};
    }
  };

  // [OPTIMASI EGRESS & LOG INGESTION]: Menerapkan Server-Side Filtering dan AbortSignal
  const fetchData = useCallback(async () => {
    // Batalkan request sebelumnya yang belum selesai untuk membersihkan log server
    if (abortControllerRef.current) {
      abortControllerRef.current.abort();
    }
    const controller = new AbortController();
    abortControllerRef.current = controller;

    setIsLoading(true);
    try {
      if (activeTab === 'pasien') {
        let queryPasien = supabase
          .from('pasien')
          .select('*')
          .order('created_at', { ascending: false })
          .abortSignal(controller.signal);

        if (searchTerm.trim() !== '') {
          queryPasien = queryPasien.or(`nama_pasien.ilike.%${searchTerm}%,no_rm.ilike.%${searchTerm}%,nik.ilike.%${searchTerm}%`);
        }

        const { data: dataPasien, error: errPasien } = await queryPasien;

        if (!errPasien && dataPasien) {
          setPatients(dataPasien);
        } else {
          setPatients([]);
        }
      } else {
        let query = supabase
          .from('transaksi_pasien')
          .select('*')
          .abortSignal(controller.signal);

        // Pindahkan filter status ke server
        if (activeTab !== 'semua') {
          query = query.eq('status_bayar', activeTab);
        }

        // Pindahkan filter metode pembayaran ke server
        if (filterMetode !== 'ALL') {
          query = query.eq('metode_pembayaran', filterMetode);
        }

        // Pindahkan filter penjaminan ke server
        if (filterPenjaminan !== 'ALL') {
          query = query.eq('jenis_penjaminan', filterPenjaminan);
        }

        // Pindahkan filter tanggal ke server
        if (filterTanggal) {
          query = query.gte('tanggal_transaksi', `${filterTanggal}T00:00:00`).lte('tanggal_transaksi', `${filterTanggal}T23:59:59`);
        }

        // Server-side search
        if (searchTerm.trim() !== '') {
          query = query.or(`nama_pasien.ilike.%${searchTerm}%,no_rm.ilike.%${searchTerm}%,id.ilike.%${searchTerm}%`);
        }

        // Sorting di server
        if (sortBy === 'newest') {
          query = query.order('tanggal_transaksi', { ascending: false });
        } else if (sortBy === 'oldest') {
          query = query.order('tanggal_transaksi', { ascending: true });
        } else if (sortBy === 'highest') {
          query = query.order('total_biaya', { ascending: false });
        } else if (sortBy === 'lowest') {
          query = query.order('total_biaya', { ascending: true });
        } else {
          query = query.order('tanggal_transaksi', { ascending: false });
        }

        const { data, error } = await query;

        if (!error && data) {
          const filtered = data.filter(item => 
            !item.jenis_layanan || item.jenis_layanan === 'rawat_jalan' || item.jenis_layanan === ''
          );
          setTransactions(filtered);
        } else {
          setTransactions([]);
        }
      }
    } catch (err: any) {
      if (err.name === 'AbortError' || err.code === '20') {
        console.log('Fetch dibatalkan untuk efisiensi jaringan.');
        return;
      }
      console.error('Gagal memuat data dari Supabase:', err);
      showToast('Gagal menyinkronkan data dengan server.', 'error');
    } finally {
      setIsLoading(false);
    }
  }, [activeTab, filterMetode, filterPenjaminan, filterTanggal, searchTerm, sortBy]);

  useEffect(() => {
    fetchData();

    const channel = supabase
      .channel('realtime_admin_verifikasi_rajal')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'transaksi_pasien' }, () => {
        fetchData();
      })
      .subscribe();

    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (searchInputRef.current) searchInputRef.current.focus();
      }
      if (e.key === 'Escape') {
        setSelectedDetail(null);
        setRejectingTx(null);
        setShowStatsModal(false);
      }
    };
    window.addEventListener('keydown', handleKeyDown);

    return () => {
      supabase.removeChannel(channel);
      window.removeEventListener('keydown', handleKeyDown);
    };
  }, [fetchData]);

  const handleApprove = async (tx: TransactionItem) => {
    try {
      const { error } = await supabase
        .from('transaksi_pasien')
        .update({ 
          status_bayar: 'lunas', 
          metode_pembayaran: tx.metode_pembayaran || 'verifikasi_admin_pusat' 
        })
        .eq('id', tx.id);

      if (error) throw new Error(error.message);
      showToast(`Tagihan ${tx.id} (${tx.nama_pasien}) berhasil diverifikasi LUNAS.`);
      fetchData();
      setSelectedDetail(null);
    } catch (err: unknown) {
      if (err instanceof Error) showToast(err.message, 'error');
    }
  };

  const handleBatchApprove = async () => {
    if (selectedTxIds.length === 0) return;
    const confirmed = confirm(`Apakah Anda yakin ingin menyetujui ${selectedTxIds.length} transaksi terpilih menjadi LUNAS secara massal?`);
    if (!confirmed) return;

    try {
      const { error } = await supabase
        .from('transaksi_pasien')
        .update({ status_bayar: 'lunas' })
        .in('id', selectedTxIds);

      if (error) throw new Error(error.message);
      showToast(`Berhasil memverifikasi ${selectedTxIds.length} transaksi menjadi LUNAS.`);
      setSelectedTxIds([]);
      fetchData();
    } catch (err: any) {
      showToast(err.message, 'error');
    }
  };

  const handleRejectSubmit = async () => {
    if (!rejectingTx) return;
    if (!adminNoteInput.trim()) {
      showToast('Harap isi alasan pembatalan/penolakan transaksi!', 'error');
      return;
    }

    try {
      const { error } = await supabase
        .from('transaksi_pasien')
        .update({
          status_bayar: 'dibatalkan',
          catatan_admin: adminNoteInput.trim()
        })
        .eq('id', rejectingTx.id);

      if (error) throw new Error(error.message);
      showToast(`Transaksi ${rejectingTx.id} telah dibatalkan.`, 'info');
      setRejectingTx(null);
      setAdminNoteInput('');
      setSelectedDetail(null);
      fetchData();
    } catch (err: unknown) {
      if (err instanceof Error) showToast(err.message, 'error');
    }
  };

  const handleDeletePermanent = async (tx: TransactionItem) => {
    const confirmed = confirm(
      `PERINGATAN AUDIT KEUANGAN!\nApakah Anda yakin ingin MENGHAPUS PERMANEN data transaksi ${tx.id} (${tx.nama_pasien})?\n\nData yang dihapus tidak dapat dikembalikan lagi.`
    );
    if (!confirmed) return;

    try {
      const { error } = await supabase
        .from('transaksi_pasien')
        .delete()
        .eq('id', tx.id);

      if (error) throw new Error(error.message);
      showToast(`Data transaksi ${tx.id} berhasil dihapus permanen.`, 'info');
      setSelectedDetail(null);
      fetchData();
    } catch (err: unknown) {
      if (err instanceof Error) showToast(err.message, 'error');
    }
  };

  const handlePrint = (tx: TransactionItem) => {
    setIsPrintingSummary(false);
    setIsPrintingSelected(false);
    setSelectedDetail(tx);
    setTimeout(() => {
      window.print();
    }, 300);
  };

  const handlePrintSummaryReport = (selectedOnly: boolean = false) => {
    if (selectedOnly && selectedTxIds.length === 0) {
      showToast('Pilih minimal satu data untuk dicetak.', 'error');
      return;
    }
    setIsPrintingSummary(true);
    setIsPrintingSelected(selectedOnly);
    setSelectedDetail(null);
    setTimeout(() => {
      window.print();
    }, 300);
  };

  const handleExportCSV = () => {
    const listToExport = transactions;
    if (listToExport.length === 0) {
      showToast('Tidak ada data untuk diekspor.', 'error');
      return;
    }

    const headers = ['ID Transaksi', 'No RM', 'Nama Pasien', 'NIK', 'Poli Tujuan', 'Penjaminan', 'Metode Bayar', 'Tanggal', 'Total Biaya (Rp)', 'Status', 'Catatan Admin'];
    const rows = listToExport.map(t => [
      t.id,
      t.no_rm,
      `"${t.nama_pasien}"`,
      `"${t.nik || '-'}"`,
      `"${t.poli_tujuan}"`,
      t.jenis_penjaminan || 'UMUM',
      t.metode_pembayaran || 'Tunai',
      new Date(t.tanggal_transaksi || '').toLocaleDateString('id-ID'),
      t.total_biaya,
      t.status_bayar,
      `"${t.catatan_admin || '-'}"`
    ]);

    const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `Laporan_Audit_Rajal_${activeTab}_${new Date().toISOString().split('T')[0]}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showToast('File laporan CSV berhasil diunduh.');
  };

  const formatRupiah = (num: number) => {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num || 0);
  };

  const formatRupiahTanpaSimbol = (num: number) => {
    return new Intl.NumberFormat('id-ID', { maximumFractionDigits: 0 }).format(num || 0);
  };

  const filteredTransactions = transactions;
  const filteredPatients = patients;

  const totalPending = transactions.filter(t => t.status_bayar === 'pending').length;
  const totalLunas = transactions.filter(t => t.status_bayar === 'lunas').length;
  const totalDibatalkan = transactions.filter(t => t.status_bayar === 'dibatalkan').length;
  
  const totalNominal = filteredTransactions
    .filter(t => t.status_bayar !== 'dibatalkan')
