        audio: false 
      });
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
      }
      addLog('Kamera depan berhasil diaktifkan.');
    } catch (err) {
      showToast('Tidak dapat mengakses kamera depan. Pastikan izin kamera aktif.', 'error');
