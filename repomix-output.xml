                  <tr key={r.id} className="hover:bg-slate-50">
                    <td className={`text-center print:hidden ${isCompact ? 'p-2' : 'p-3.5'}`}>
                      <button onClick={() => handleToggleSelectOne(r.id)} className="cursor-pointer">
