              <button onClick={() => setModalMode(null)} disabled={isSubmittingModal} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs py-3 rounded-2xl transition cursor-pointer">Batal</button>
